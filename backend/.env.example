# ===== Server =====
NODE_ENV=development
PORT=5000
# Frontend manzili (CORS uchun). Vergul bilan bir nechta berish mumkin.
CLIENT_URL=http://localhost:3000

# ===== MongoDB =====
MONGODB_URI=mongodb://127.0.0.1:27017/behzod_avtoustoz

# ===== JWT =====
JWT_SECRET=CHANGE_ME_super_secret_access_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_super_secret_refresh_key
JWT_REFRESH_EXPIRES_IN=30d
# Cookie domeni (production'da .behzod-avtoustoz.uz). Bo'sh bo'lsa host bo'yicha.
COOKIE_DOMAIN=

# ===== Fayl yuklash =====
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# ===== SMS (Eskiz.uz) =====
# Bo'sh bo'lsa "dev rejim": tasdiqlash kodi konsolga chiqadi, SMS yuborilmaydi.
SMS_PROVIDER=eskiz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
ESKIZ_BASE_URL=https://notify.eskiz.uz/api

# ===== Click =====
# Bo'sh bo'lsa to'lov "dev/manual" rejimda ishlaydi.
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

# ===== Payme =====
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

# Narxlar tiyinda emas, so'mda saqlanadi (UZS).
